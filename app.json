  "drivers": [
    {
      "id": "webos_plus",
      "name": {
        "en": "Local webOS TV Controller",
        "nl": "Lokale webOS-tv-controller"
      },
      "class": "tv",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "discovery": "webos",
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_my_devices"
          }
        },
        {
          "id": "add_my_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Advanced settings",
            "nl": "Geavanceerde instellingen"
          },
          "children": [
            {
              "id": "powerStateTimeout",
              "type": "number",
              "label": {
                "en": "Power-listener timeout",
                "nl": "Time-out van powerlistener"
              },
              "hint": {
                "en": "Time allowed for the WebSocket power listener to detect that the TV has turned off. Increase this only if remote-control power-off is not registered reliably. A value that is too short can make detection unreliable.",
                "nl": "Tijd waarin de WebSocket-powerlistener kan detecteren dat de TV is uitgeschakeld. Verhoog dit alleen als uitschakelen met de afstandsbediening niet betrouwbaar wordt geregistreerd. Een te korte tijd kan de detectie onbetrouwbaar maken."
              },
              "value": 2000,
              "min": 0,
              "max": 60000,
              "units": {
                "en": "milliseconds",
                "nl": "milliseconden"
              }
            },
            {
              "id": "usePoll",
              "type": "checkbox",
              "label": {
                "en": "Use polling instead of power listener",
                "nl": "Gebruik polling in plaats van de powerlistener"
              },
              "hint": {
                "en": "Disable the power listener and periodically check whether the TV is on or off. Polling may work better when the power listener is unreliable for a television.",
                "nl": "Schakel de powerlistener uit en controleer regelmatig of de TV aan of uit staat. Polling kan beter werken wanneer de powerlistener niet betrouwbaar is voor een televisie."
              },
              "value": false
            },
            {
              "id": "pollInterval",
              "type": "number",
              "label": {
                "en": "Polling interval",
                "nl": "Pollinginterval"
              },
              "hint": {
                "en": "Time between polling checks. Change this only if remote-control power changes are not detected reliably. A longer interval reduces check frequency.",
                "nl": "Tijd tussen pollingcontroles. Wijzig dit alleen als aan-uitwijzigingen via de afstandsbediening niet betrouwbaar worden gedetecteerd. Een langer interval vermindert de controlefrequentie."
              },
              "value": 10,
              "min": 5,
              "max": 3600,
              "units": {
                "en": "seconds",
                "nl": "seconden"
              }
            },
            {
              "id": "pollTimeout",
              "type": "number",
              "label": {
                "en": "Polling timeout",
                "nl": "Time-out voor polling"
              },
              "hint": {
                "en": "Time after which a failed polling check treats the TV as off. Keep this shorter than the polling interval.",
                "nl": "Tijd waarna een mislukte pollingcontrole de TV als uitgeschakeld beschouwt. Houd dit korter dan het pollinginterval."
              },
              "value": 8,
              "min": 0,
              "max": 3600,
              "units": {
                "en": "seconds",
                "nl": "seconden"
              }
            },
            {
              "id": "manualIpAddress",
              "type": "checkbox",
              "label": {
                "en": "Set IP address manually",
                "nl": "IP-adres handmatig instellen"
              },
              "value": false
            },
            {
              "id": "ipAddress",
              "type": "text",
              "label": {
                "en": "TV IP address",
                "nl": "IP-adres van de TV"
              },
              "value": "0.0.0.0"
            }
          ]
        }
      ],
      "capabilities": [
        "onoff",
        "volume_set",
        "channel_up",
        "volume_up",
        "channel_down",
        "volume_down",
        "volume_mute",
        "webos_display.app",
        "webos_display.channel"
      ],
      "capabilitiesOptions": {
        "onoff": {
          "uiQuickAction": true
        },
        "volume_set": {
          "units": "%",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "decimals": 2
        },
        "webos_display.app": {
          "title": {
            "en": "App or input",
            "nl": "App of ingang"
          },
          "preventInsights": true,
          "preventTag": true
        },
        "webos_display.channel": {
          "title": {
            "en": "Channel",
            "nl": "Kanaal"
          },
          "preventInsights": true,
          "preventTag": true
        }
      },
      "images": {
        "large": "/drivers/webos_plus/assets/images/large.png",
        "small": "/drivers/webos_plus/assets/images/small.png",
        "xlarge": "/drivers/webos_plus/assets/images/xlarge.png"
      }
    }
  ]
