{
  "id": "com.rompa.webos-plus-g4",
  "version": "1.0.43",
  "compatibility": ">=5.0.0",
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "sdk": 3,
  "name": {
    "en": "Local webOS TV Controller",
    "nl": "Lokale webOS-tv-controller"
  },
  "brandColor": "#123C4A",
  "description": {
    "en": "Bring local television control into your everyday Flows",
    "nl": "Neem lokale televisiebediening op in je dagelijkse Flows"
  },
  "tags": {
    "en": [
      "lg",
      "lgtv",
      "WebOS",
      "tv",
      "television",
      "video"
    ],
    "nl": [
      "lg",
      "lgtv",
      "WebOS",
      "tv",
      "televisie",
      "video"
    ]
  },
  "category": "video",
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "John Bear"
  },
  "contributors": {
    "developers": [
      {
        "name": "Max van de Laar"
      },
      {
        "name": "Dominic Vonk"
      },
      {
        "name": "Paul Molensky"
      }
    ],
    "translators": [
      {
        "name": "Max van de Laar"
      }
    ]
  },
  "support": "mailto:wakeful.issue_8i@icloud.com",
  "source": "https://github.com/EditBear/homey-local-webos-tv-controller",
  "bugs": {
    "url": "https://github.com/EditBear/homey-local-webos-tv-controller/issues"
  },
  "discovery": {
    "webos": {
      "type": "ssdp",
      "ssdp": {
        "search": "urn:lge-com:service:webos-second-screen:1"
      },
      "id": "{{headers.usn}}",
      "conditions": [
        [
          {
            "field": "headers.st",
            "match": {
              "type": "string",
              "value": "urn:lge-com:service:webos-second-screen:1"
            }
          }
        ]
      ]
    }
  },
  "capabilities": {
    "webos_display": {
      "type": "string",
      "title": {
        "en": "TV information",
        "nl": "TV-informatie"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "webos_channel_changed",
        "title": {
          "en": "Channel changed",
          "nl": "Kanaal gewijzigd"
        },
        "args": [
          {
            "name": "webosDevice",
            "type": "device",
            "filter": "driver_id=webos_plus"
          }
        ],
        "tokens": [
          {
            "name": "oldChannel",
            "type": "string",
            "title": {
              "en": "Previous channel",
              "nl": "Vorig kanaal"
            },
            "example": "1"
          },
          {
            "name": "newChannel",
            "type": "string",
            "title": {
              "en": "Current channel",
              "nl": "Huidig kanaal"
            },
            "example": "2"
          }
        ]
      },
      {
        "id": "webos_channel_changed_to_number",
