#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo "Install Node.js 22.12 or later in the 22 series, or Node.js 24 or newer, with npm." >&2
  exit 1
fi

if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major >= 24 || (major === 22 && minor >= 12) ? 0 : 1)'; then
  echo "Node.js 22.12 or later in the 22 series, or Node.js 24 or newer, is required." >&2
  exit 1
fi

cd "$PROJECT_ROOT"
export NO_UPDATE_NOTIFIER=1
export HOMEY_SKIP_STARTUP_NOTIFIERS=1
exec npm exec --yes --package=homey@4.4.1 -- homey "$@"
